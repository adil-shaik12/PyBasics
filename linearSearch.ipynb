    "def linearSearch(arr,val):\n",
    "    for i in range(len(arr)):\n",
    "        if arr[i]==val:\n",
    "            return i\n",
    "    return -1\n",
    "list=[3,5,2,4,8,6,7,9,1]\n",
    "x=8\n",
    "result=linearSearch(list,x)\n",
    "if result!=1:\n",
    "    print(\"found at index\",result)\n",
    "else:\n",
    "    print(\"not found\")"
