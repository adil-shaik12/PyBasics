   "source": [
    "list=[7,3,9,12,11]\n",
    "n=len(list)\n",
    "for i in range(n-1):\n",
    "    swapped = False\n",
    "    for j in range(n-i-1):\n",
    "        if list[j]>list[j+1]:   \n",
    "            list[j],list[j+1]=list[j+1],list[j]\n",
    "            swapped=True\n",
    "        if not swapped:\n",
    "            break\n",
    "print(list)"
   ]
  },
