   "source": [
    "mylist=[64,34,25,12,22,11,90,5]\n",
    "n=len(mylist)\n",
    "for i in range(1,n):\n",
    "    insert_index = i\n",
    "    current_value = mylist.pop(i)\n",
    "    for j in range(i-1, -1, -1):\n",
    "        if mylist[j] > current_value:\n",
    "            insert_index = j\n",
    "    mylist.insert(insert_index, current_value)\n",
    "print(mylist)"
   ]
